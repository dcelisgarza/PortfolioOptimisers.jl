    {
      "parameters": {
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "test (1, ubuntu-latest, x64, false) / Julia 1 - ubuntu-latest - x64 - push",
            "integration_id": 15368
          },
          {
            "context": "JET - push",
            "integration_id": 15368
          },
          {
            "context": "Complexity - push",
            "integration_id": 15368
          },
          {
            "context": "Aqua - push",
            "integration_id": 15368
          },
          {
            "context": "Documentation - push",
            "integration_id": 15368
          },
          {
            "context": "Doctests - push",
            "integration_id": 15368
          },
          {
            "context": "Paper - push",
            "integration_id": 15368
          },
          {
            "context": "Format check - push",
            "integration_id": 15368
          },
          {
            "context": "Link checker - push",
            "integration_id": 15368
          }
        ],
        "strict_required_status_checks_policy": false
      },
      "type": "required_status_checks"
    }
  ],
  "target": "branch"
